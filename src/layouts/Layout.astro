---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = 'Euael M. Eshete · Software Engineer',
  description = 'Software engineer in Addis Ababa building high-concurrency backend systems, cloud infrastructure, and AI-native products. Founder of ZafTech, creator of Convia and Relay.',
  ogImage = 'https://portfolio.euaell.me/og-image.png',
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Euael M. Eshete" />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Euael M. Eshete" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@euaell" />

    <!-- Only these two icon assets exist; the previous markup referenced five
         files that were never in the repo and 404'd on every load. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/Logo.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme follows the OS. These two values must track the token layer. -->
    <meta name="theme-color" content="#f0f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121113" media="(prefers-color-scheme: dark)" />

    <!-- Self-hosted. The variable upright covers every heading on first paint,
         so it is worth preloading; the italic is not. -->
    <link
      rel="preload"
      href="/fonts/archivo/archivo-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="meta">&copy; {year} Euael M. Eshete</p>
        <nav aria-label="Elsewhere">
          <ul class="footer-links">
            <li><a class="footer-link" href="https://github.com/euaell" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a class="footer-link" href="https://www.linkedin.com/in/euael-eshete" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a class="footer-link" href="mailto:euaelmeko@gmail.com">Email</a></li>
          </ul>
        </nav>
      </div>
    </footer>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QZW3GEJSTM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-QZW3GEJSTM', { page_path: window.location.pathname });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 500;
    transition: top var(--dur) var(--ease);
  }

  .skip-link:focus-visible {
    top: var(--space-4);
  }

  .site-footer {
    border-top: var(--border-width) solid var(--border);
    padding-block: var(--space-6);
    margin-top: var(--space-9);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color var(--dur) var(--ease);
  }

  .footer-link:hover {
    color: var(--accent-text);
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
