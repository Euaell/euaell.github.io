---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Page not found - Euael M. Eshete" description="The page you are looking for does not exist." noIndex>
  <main id="main" class="flex min-h-svh items-center justify-center px-4 text-center">
    <div>
      <p class="mb-3 text-xs tracking-kicker text-white/50 uppercase">404</p>
      <h1 class="mb-4 font-display text-3xl font-semibold md:text-5xl">Page not found</h1>
      <p class="mb-8 text-white/70">The page you are looking for does not exist or has moved.</p>
      <a href="/" class="btn-primary inline-flex">Back to home</a>
    </div>
  </main>
</Layout>
