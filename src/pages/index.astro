---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/ui/Navigation.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import WorkSection from '@/components/sections/WorkSection.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
---

<Layout
  title="Euael M. Eshete - Software Engineer"
  description="Software engineer working on PKI, multi-tenant SaaS, licensing, and cloud infrastructure with .NET, Python, Go, and TypeScript."
>
  <Fragment slot="head">
    <StructuredData />
  </Fragment>

  <Navigation />

  <main class="md:-mt-13">
    <HeroSection />
    <AboutSection />
    <WorkSection />
    <ContactSection />
  </main>
</Layout>
