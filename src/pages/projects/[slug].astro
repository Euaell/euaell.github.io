---
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/ui/Navigation.astro";
import StructuredData from "@/components/seo/StructuredData.astro";
import { projectsData, type Project } from "@/data/projects";
import { siteLinks } from "@/data/profile";
export function getStaticPaths() {
  return projectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const nextProject =
  projectsData[
    (projectsData.findIndex((item) => item.slug === project.slug) + 1) %
      projectsData.length
  ];
---

<Layout
  title={project.title + " — Engineering work | Euael M. Eshete"}
  description={project.summary}
>
  <Fragment slot="head"
    ><StructuredData page="project" project={project} /></Fragment
  >
  <Navigation />
  <main id="main">
    <article class="section case-study">
      <div class="container">
        <nav class="case-breadcrumb" aria-label="Breadcrumb">
          <a href="/projects">All projects</a><span aria-hidden="true">/</span
          ><span>{project.title}</span>
        </nav>
        <header class="case-head">
          <h1 class="display">{project.title}</h1><p class="case-summary">
            {project.summary}
          </p><p class="case-role">
            {project.role}<span aria-hidden="true">·</span>{project.year}
          </p>
        </header>
        {
          project.image && (
            <figure class="case-image">
              <img
                src={project.image}
                alt={project.imageAlt}
                width={project.imageWidth}
                height={project.imageHeight}
                fetchpriority="high"
              />
              {project.slug === "mizan" && (
                <figcaption>The daily log, shown with demo data.</figcaption>
              )}
            </figure>
          )
        }
        <div class="case-body">
          <div class="case-overview">
            <h2>Context</h2><p>{project.description}</p><ul class="case-stack">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
          <div class="case-contributions">
            <h2>Engineering work</h2><ul>
              {project.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
            {
              (project.link || project.repositoryLink) && (
                <div class="case-links">
                  {project.link && (
                    <a
                      class="btn btn-primary"
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Visit project{" "}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M5 19 19 5M5 5h14v14" />
                      </svg>
                    </a>
                  )}
                  {project.repositoryLink && (
                    <a
                      class="text-link"
                      href={project.repositoryLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      View source{" "}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        aria-hidden="true"
                      >
                        <path d="M5 19 19 5M5 5h14v14" />
                      </svg>
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </div>
        <footer class="case-footer">
          <a class="text-link" href={"/projects/" + nextProject.slug}
            >Next: {nextProject.title}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"></path></svg
            ></a
          ><a class="text-link" href={"mailto:" + siteLinks.email}
            >Let’s talk</a>
        </footer>
      </div>
    </article>
  </main>
</Layout>
<style>
  .case-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .case-breadcrumb a {
    text-decoration: underline;
  }
  .case-head {
    max-width: 900px;
  }
  .case-head .display {
    font-size: clamp(2.8rem, 6.5vw, 5.5rem);
  }
  .case-summary {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    color: var(--text-secondary);
    max-width: 64ch;
    margin-top: 1.8rem;
    line-height: 1.6;
  }
  .case-role {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-top: 1.5rem;
  }
  .case-image {
    margin: 3rem 0 0;
  }
  .case-image img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .case-image figcaption {
    color: var(--text-muted);
    font-size: 0.8125rem;
    margin-top: 0.75rem;
  }
  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
  .case-body h2 {
    font-size: 1.4rem;
    margin-bottom: 1.4rem;
  }
  .case-body p,
  .case-contributions li {
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 1.5rem;
  }
  .case-contributions > ul {
    list-style: disc;
    padding-left: 1.1rem;
  }
  .case-contributions li + li {
    margin-top: 1.2rem;
  }
  .case-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .case-links svg {
    width: 18px;
    height: 18px;
  }
  .case-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding-top: 2rem;
  }
  @media (max-width: 650px) {
    .case-body {
      grid-template-columns: 1fr;
      margin-top: 2.5rem;
      padding-top: 2rem;
    }
    .case-head .display {
      font-size: clamp(2.5rem, 10vw, 3.5rem);
      overflow-wrap: break-word;
    }
  }
</style>
