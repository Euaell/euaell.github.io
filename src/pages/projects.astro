---
import Layout from "@/layouts/Layout.astro";
import Navigation from "@/components/ui/Navigation.astro";

import ProjectFilter, { type ProjectCard } from "@/components/ui/ProjectFilter";
import { projectsData } from "@/data/projects";
import StructuredData from "@/components/seo/StructuredData.astro";

const rank: Record<string, number> = {
  "pki-trust-manager": 0,
  convia: 1,
  relay: 2,
  rms: 3,
  "project-life-manager": 4,
  afrochat: 5,
  mizan: 6,
  distrokv: 7,
};
const projects: ProjectCard[] = [...projectsData].sort(
  (a, b) => (rank[a.slug] ?? 99) - (rank[b.slug] ?? 99),
);
---

<Layout
  title="Projects · Euael M. Eshete"
  description="Selected engineering work by Euael M. Eshete: certificate infrastructure, multi-tenant SaaS, durable AI tool execution, and product development."
>
  <Navigation />
  <Fragment slot="head"><StructuredData page="projects" /></Fragment>

  <main id="main">
    <section class="section">
      <div class="container">
        <header class="page-head">
          <h1 class="display page-title">Work, in more detail.</h1>
          <p class="lede">
            Products, platforms, and systems work. Filter by technology if you
            are looking for something specific.
          </p>
        </header>

        <ProjectFilter client:visible projects={projects} />
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-head {
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .page-head .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-bottom: var(--space-3);
  }
</style>
