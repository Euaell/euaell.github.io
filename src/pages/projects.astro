---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/ui/Navigation.astro';
import FloatingResumeButton from '@/components/ui/FloatingResumeButton.astro';
import ProjectFilter, { type ProjectCard } from '@/components/ui/ProjectFilter';
import { projectsData } from '@/data/projects';

// Narrow the full records down to what the filter island renders.
const projects: ProjectCard[] = projectsData.map(
  ({ slug, title, summary, tags, image, imageAlt, link, repositoryLink, featured }) => ({
    slug,
    title,
    summary,
    tags,
    image,
    imageAlt,
    link,
    repositoryLink,
    featured,
  })
);
---

<Layout
  title="Projects · Euael M. Eshete"
  description="Systems built by Euael M. Eshete: Convia, Relay, a multi-tenant PKI platform, Mizan, DistroKV, and AfroChat."
>
  <Navigation />

  <main id="main">
    <section class="section">
      <div class="container">
        <header class="page-head">
          <p class="eyebrow">Projects</p>
          <h1 class="display page-title">Everything I have built</h1>
          <p class="lede">
            Products, platforms, and systems work. Filter by technology if you are
            looking for something specific.
          </p>
        </header>

        <ProjectFilter client:visible projects={projects} />
      </div>
    </section>
  </main>

  <FloatingResumeButton />
</Layout>

<style>
  .page-head {
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .page-head .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
  }

  .page-title {
    margin-bottom: var(--space-3);
  }
</style>
