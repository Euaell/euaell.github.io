---
import Layout from '@/layouts/Layout.astro';
import ProjectFilter from '@/components/ui/ProjectFilter';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { projectsData } from '@/data';

const technologies = [...new Set(projectsData.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b));
---

<Layout
  title="Projects - Euael M. Eshete"
  description="Explore my portfolio of systems, PKI and multi-tenant SaaS, distributed architectures, and AI tooling."
>
  <main id="main">
    <section class="pt-8 pb-16 md:pt-12 md:pb-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading as="h1" eyebrow="Archive" title="All Projects" />

        <ProjectFilter client:visible projects={projectsData} technologies={technologies} />

        <div class="mt-12 text-center">
          <a href="/#work" class="btn-secondary inline-flex items-center gap-2 px-8 py-3">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to home
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
