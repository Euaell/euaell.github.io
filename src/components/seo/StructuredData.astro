---
import { profileInfo } from '@/data';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profileInfo.name,
  jobTitle: profileInfo.title,
  url: 'https://portfolio.euaell.me',
  email: profileInfo.email,
  sameAs: profileInfo.socialLinks.map((s) => s.href),
  knowsAbout: [
    'PKI & X.509',
    'Multi-Tenant SaaS',
    'C# & .NET',
    'ASP.NET Core',
    'Python',
    'FastAPI',
    'Go',
    'TypeScript',
    'Distributed Systems',
    'Cloud Infrastructure & Docker',
  ],
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Addis Ababa University',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'SecureTron Inc.',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${profileInfo.name} Portfolio`,
  url: 'https://portfolio.euaell.me',
  description: profileInfo.description,
  author: {
    '@type': 'Person',
    name: profileInfo.name,
  },
};

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2023-01-01',
  dateModified: new Date().toISOString().split('T')[0],
  mainEntity: {
    '@type': 'Person',
    name: profileInfo.name,
    jobTitle: profileInfo.title,
    description: profileInfo.description,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
