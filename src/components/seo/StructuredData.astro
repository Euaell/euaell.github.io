---
import { getImage } from 'astro:assets';
import { profileInfo, socialLinks } from '@/data';

const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#person`;
const portrait = await getImage({ src: profileInfo.image, width: 512, height: 512, format: 'jpg' });

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profileInfo.name,
      jobTitle: profileInfo.title,
      description: profileInfo.description,
      url: siteUrl,
      image: new URL(portrait.src, Astro.site).href,
      email: `mailto:${profileInfo.email}`,
      sameAs: socialLinks.filter((s) => s.href.startsWith('http')).map((s) => s.href),
      knowsAbout: [
        'PKI & X.509',
        'Multi-Tenant SaaS',
        'C# & .NET',
        'ASP.NET Core',
        'Python',
        'FastAPI',
        'Go',
        'TypeScript',
        'Distributed Systems',
        'Cloud Infrastructure & Docker',
      ],
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Addis Ababa University' },
      worksFor: { '@type': 'Organization', name: 'Securetron' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: `${profileInfo.name} Portfolio`,
      url: siteUrl,
      description: profileInfo.description,
      author: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      url: siteUrl,
      mainEntity: { '@id': personId },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
