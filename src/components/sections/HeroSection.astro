---
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { profileInfo, socialLinks } from '@/data';

const [firstFocus] = profileInfo.focusAreas;
---

<section id="home" aria-labelledby="hero-title" class="relative flex min-h-svh items-center overflow-hidden">
  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-16 pb-24 sm:px-6 md:pt-20 md:pb-32 lg:px-8">
    <div class="mx-auto flex max-w-5xl flex-col items-center px-4 text-center">
      <h1
        id="hero-title"
        class="animate-fade-up mb-5 font-display text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
      >
        <span class="gradient-text">{profileInfo.name}</span>
      </h1>

      <p class="animate-fade-up mb-6 text-lg text-white/85 sm:text-xl md:text-2xl" style="--delay: 100ms">
        <span class="sr-only">{profileInfo.title} building {profileInfo.focusAreas.join(', ')}.</span>
        <span class="flex flex-wrap items-center justify-center gap-x-2" aria-hidden="true">
          <span>{profileInfo.title} building</span>
          <span
            id="rotating-focus"
            class="cyber-glitch gradient-text-primary relative inline-block min-w-37.5 text-left font-semibold select-none"
            data-text={firstFocus}
            data-items={JSON.stringify(profileInfo.focusAreas)}>{firstFocus}</span
          >
        </span>
      </p>

      <p class="animate-fade-up mx-auto mb-8 max-w-2xl text-base leading-relaxed text-white/65 md:text-lg" style="--delay: 200ms">
        Building PKI, multi-tenant SaaS, licensing engines, and auth systems with C#/.NET, Python, Go, and TypeScript.
      </p>

      <div class="animate-fade-up mb-8 flex flex-col items-center justify-center gap-3 sm:flex-row md:gap-4" style="--delay: 300ms">
        <a href="#work" class="btn-primary inline-flex w-full items-center justify-center gap-2 sm:w-auto">
          View My Work
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a href="#contact" class="btn-secondary inline-flex w-full items-center justify-center gap-2 sm:w-auto">
          Get In Touch
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10m-13 9h16a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>

      <ul class="animate-fade-up flex items-center justify-center gap-3 md:gap-4" style="--delay: 400ms">
        {
          socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.icon === 'mail' ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="block rounded-full border border-white/10 bg-white/3 p-3 text-white/70 transition hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/7 hover:text-white"
                aria-label={social.label}
              >
                <SocialIcon name={social.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-10 left-1/2 flex -translate-x-1/2 animate-bounce-slow flex-col items-center gap-2 text-white/50 transition-colors hover:text-white"
  >
    <span class="text-xs tracking-caps uppercase">Scroll</span>
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </a>
</section>

<script>
  const GLYPHS = '!<>-_\\/[]{}—=+*^?#________0101XYZ';
  const HOLD_MS = 2600;

  interface Slot {
    from: string;
    to: string;
    start: number;
    end: number;
    glyph?: string;
  }

  /** Decodes one string into another through random glyphs, one animation frame at a time */
  class TextScramble {
    private queue: Slot[] = [];
    private frame = 0;
    private request = 0;
    private resolve = () => {};

    constructor(private el: HTMLElement) {}

    setText(next: string): Promise<void> {
      const prev = this.el.textContent ?? '';
      const length = Math.max(prev.length, next.length);

      this.queue = Array.from({ length }, (_, i) => {
        const start = Math.floor(Math.random() * 8);
        return { from: prev[i] ?? '', to: next[i] ?? '', start, end: start + 6 + Math.floor(Math.random() * 12) };
      });

      cancelAnimationFrame(this.request);
      this.frame = 0;
      this.el.dataset.text = next;
      this.el.classList.add('is-glitching');

      return new Promise((resolve) => {
        this.resolve = resolve;
        this.update();
      });
    }

    private update = () => {
      const nodes: (string | Node)[] = [];
      let done = 0;

      for (const slot of this.queue) {
        if (this.frame >= slot.end) {
          done++;
          nodes.push(slot.to);
        } else if (this.frame >= slot.start) {
          if (!slot.glyph || Math.random() < 0.28) {
            slot.glyph = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          }
          const glyph = document.createElement('span');
          glyph.className = 'font-mono text-blue-slate-400 opacity-40';
          glyph.textContent = slot.glyph;
          nodes.push(glyph);
        } else {
          nodes.push(slot.from);
        }
      }

      this.el.replaceChildren(...nodes);

      if (done === this.queue.length) {
        this.el.classList.remove('is-glitching');
        this.resolve();
      } else {
        this.frame++;
        this.request = requestAnimationFrame(this.update);
      }
    };
  }

  const el = document.getElementById('rotating-focus');

  if (el) {
    const items: string[] = JSON.parse(el.dataset.items ?? '[]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrambler = new TextScramble(el);
    let index = 0;

    const next = async () => {
      index = (index + 1) % items.length;
      if (reduceMotion) {
        el.textContent = items[index];
      } else {
        await scrambler.setText(items[index]);
      }
      setTimeout(next, HOLD_MS);
    };

    if (items.length > 1) setTimeout(next, HOLD_MS);
  }
</script>

<style>
  /* Chromatic aberration copies of the text while it decodes */
  .cyber-glitch.is-glitching::before,
  .cyber-glitch.is-glitching::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cyber-glitch.is-glitching::before {
    left: -2px;
    text-shadow: 2px 0 var(--color-dark-slate-grey-400);
    animation: cyber-glitch-1 0.35s steps(2, end) infinite;
  }

  .cyber-glitch.is-glitching::after {
    left: 2px;
    text-shadow: -2px 0 rgb(225 29 72 / 0.75);
    animation: cyber-glitch-2 0.35s steps(2, end) infinite;
  }

  @keyframes cyber-glitch-1 {
    0% {
      clip-path: polygon(0 15%, 100% 15%, 100% 40%, 0 40%);
      transform: translate(-2px, -1px);
    }
    33% {
      clip-path: polygon(0 50%, 100% 50%, 100% 75%, 0 75%);
      transform: translate(2px, 1px);
    }
    66% {
      clip-path: polygon(0 0%, 100% 0%, 100% 30%, 0 30%);
      transform: translate(-1px, 2px);
    }
    100% {
      clip-path: polygon(0 70%, 100% 70%, 100% 95%, 0 95%);
      transform: translate(0, 0);
    }
  }

  @keyframes cyber-glitch-2 {
    0% {
      clip-path: polygon(0 60%, 100% 60%, 100% 85%, 0 85%);
      transform: translate(2px, 1px);
    }
    33% {
      clip-path: polygon(0 10%, 100% 10%, 100% 35%, 0 35%);
      transform: translate(-2px, -1px);
    }
    66% {
      clip-path: polygon(0 40%, 100% 40%, 100% 65%, 0 65%);
      transform: translate(1px, -1px);
    }
    100% {
      clip-path: polygon(0 80%, 100% 80%, 100% 100%, 0 100%);
      transform: translate(0, 0);
    }
  }
</style>
