---
import { profileInfo, siteLinks } from "@/data/profile";
---

<section id="home" class="hero">
  <div class="container">
    <h1 class="display hero-name">
      {profileInfo.name}<span aria-hidden="true">.</span>
    </h1>
    <p class="hero-role">
      Software Engineer <span aria-hidden="true">/</span>
      <a href={siteLinks.studio} target="_blank" rel="noopener noreferrer"
        >Founder at ZafTech</a
      >
    </p>
    <div class="hero-bottom">
      <p class="hero-description">
        Secure multi-tenant systems and AI products.<br class="desktop-break" /> Built
        from the backend to the infrastructure.
      </p>
      <a class="hero-work" href="#work"
        ><span>Explore selected work</span><span
          class="arrow-disc"
          aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"><path d="M12 4v16m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </div>
    <div class="hero-foot">
      <p>{profileInfo.location}</p><p>Software Developer at Securetron</p>
    </div>
  </div>
</section>
<style>
  .hero {
    padding-top: clamp(4.5rem, 9vw, 8rem);
    padding-bottom: 2rem;
  }
  .hero-name {
    text-align: center;
    font-size: clamp(3rem, 7.6vw, 6rem);
    white-space: nowrap;
  }
  .hero-name span {
    color: var(--accent-mark);
  }
  .hero-role {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1.4rem;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    letter-spacing: -0.015em;
    color: var(--text-secondary);
  }
  .hero-role > span {
    color: var(--border-strong);
  }
  .hero-role a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
  }
  .hero-role a:hover {
    text-decoration-color: var(--accent-mark);
  }
  .hero-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    max-width: 870px;
    margin: 3.5rem auto 4.5rem;
  }
  .hero-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .hero-work {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .arrow-disc {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .arrow-disc svg {
    width: 21px;
    height: 21px;
    transition: transform var(--dur) var(--ease);
  }
  .hero-work:hover .arrow-disc {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: var(--btn-bg);
  }
  .hero-work:hover svg {
    transform: translateY(3px);
  }
  .hero-foot {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-name {
      animation: settle 850ms var(--ease) both;
    }
    @keyframes settle {
      from {
        transform: translateY(16px);
        letter-spacing: -0.025em;
      }
      to {
        transform: translateY(0);
        letter-spacing: -0.04em;
      }
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding-top: 3.8rem;
    }
    .hero-name {
      white-space: normal;
      max-width: 10ch;
      margin: auto;
      font-size: clamp(3.1rem, 11.6vw, 4.5rem);
    }
    .hero-role {
      font-size: 1rem;
      gap: 0.25rem 0.6rem;
      margin-top: 1.2rem;
    }
    .hero-bottom {
      flex-direction: column;
      align-items: center;
      gap: 1.65rem;
      margin: 2rem auto 3rem;
      text-align: center;
    }
    .hero-description {
      font-size: 0.9375rem;
      max-width: 34ch;
    }
    .desktop-break {
      display: none;
    }
    .hero-foot p:last-child {
      display: none;
    }
  }
</style>
