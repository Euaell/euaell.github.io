---
import { Image } from 'astro:assets';
import { profileInfo, siteLinks } from '@/data/profile';
import profileImage from '@/assets/profile.jpg';

// Proof points are drawn from the CV and contribution extracts. Each is a
// verifiable outcome, not a self-description.
const proof = [
  { value: '574', label: 'commits on a production PKI platform' },
  { value: '77', label: 'merged pull requests shipped' },
  { value: '58k', label: 'monthly messages, up from 1,250' },
  { value: '94%', label: 'infrastructure overhead removed' },
];
---

<section id="home" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="display hero-name">{profileInfo.name}</h1>

      <p class="hero-role">{profileInfo.title}</p>

      <p class="lede hero-lede">{profileInfo.tagline}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">View work</a>
        <a class="btn btn-secondary" href="#contact">Get in touch</a>
      </div>

      <p class="meta hero-meta">
        <span>{profileInfo.location}</span>
        <span class="sep" aria-hidden="true">·</span>
        <a class="link" href={siteLinks.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a class="link" href={siteLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>
    </div>

    <div class="hero-portrait">
      <Image
        src={profileImage}
        alt={`Portrait of ${profileInfo.name}`}
        width={640}
        height={800}
        widths={[320, 480, 640]}
        sizes="(min-width: 900px) 22rem, min(20rem, 100vw)"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="container">
    <dl class="proof">
      {
        proof.map((item) => (
          <div class="proof-item">
            <dt class="proof-value">{item.value}</dt>
            <dd class="proof-label">{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Top padding is capped and paired with the portrait, so the hero fills the
     first viewport at desktop without floating content halfway down. */
  .hero {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero-copy {
    max-width: 34rem;
  }

  .hero-name {
    /* Clamp keeps the name to two lines at 360px and one generous line up. */
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 3.75rem);
    letter-spacing: -0.035em;
    margin-bottom: var(--space-3);
  }

  .hero-role {
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--accent-text);
    margin-bottom: var(--space-4);
  }

  .hero-lede {
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) 0;
  }

  .hero-portrait {
    position: relative;
    max-width: 20rem;
    width: 100%;
    justify-self: start;
  }

  .hero-portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--border);
    /* A single tinted shadow, no glow. */
    box-shadow: var(--shadow-raised);
  }

  /* Proof strip: real outcomes, separated by rules rather than boxed cards. */
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--border);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .proof-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }

  .proof-label {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 22ch;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--space-8);
      padding-bottom: var(--space-9);
    }

    .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      /* Asymmetric: copy leads, portrait is a smaller anchor. */
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-8);
    }

    .hero-portrait {
      justify-self: end;
      max-width: 22rem;
    }
  }
</style>
