---
import { featuredProjects } from '@/data/projects';

// Featured work renders as full-width rows rather than a card grid: for three
// substantial projects, a row gives each one a readable screenshot and room to
// state the actual contribution. Cards would crush that into thumbnails.
---

<section id="work" class="section">
  <div class="container">
    <header class="section-head">
      <h2 class="heading">Selected work</h2>
      <p class="lede">
        Four systems I have designed, built, and shipped. Each one is in production
        or under active development.
      </p>
    </header>

    <div class="work-list">
      {
        featuredProjects.map((project, index) => (
          <article class="work-item" data-index={index}>
            {project.image ? (
              <div class="work-media">
                <img
                  src={project.image}
                  alt={project.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                  width="1600"
                  height="1000"
                />
              </div>
            ) : (
              <div class="work-media work-media--text" aria-hidden="true">
                <span class="work-media-mark">{project.title.charAt(0)}</span>
              </div>
            )}

            <div class="work-body">
              <p class="meta work-role">
                <span>{project.role}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span>{project.year}</span>
              </p>

              <h3 class="work-title">{project.title}</h3>

              <p class="work-summary">{project.summary}</p>

              <ul class="work-highlights">
                {project.highlights.slice(0, 3).map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <ul class="work-tags">
                {project.tags.slice(0, 5).map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>

              <p class="work-links">
                {project.link && (
                  <a class="link" href={project.link} target="_blank" rel="noopener noreferrer">
                    {project.linkLabel ?? 'Visit site'}
                  </a>
                )}
                {project.link && project.repositoryLink && (
                  <span class="sep" aria-hidden="true">·</span>
                )}
                {project.repositoryLink && (
                  <a class="link" href={project.repositoryLink} target="_blank" rel="noopener noreferrer">
                    Source
                  </a>
                )}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .section-head .heading {
    margin-bottom: var(--space-3);
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .work-item {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .work-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--border);
    background: var(--surface);
  }

  /* Fallback for projects with no capture available. Deliberately plain: a
     large initial on a flat surface reads as intentional, where a stock or
     generated stand-in would read as filler. */
  .work-media--text {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--border);
    background: var(--surface);
  }

  .work-media-mark {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 6vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-mark);
    opacity: 0.45;
  }

  .work-role {
    margin-bottom: var(--space-2);
  }

  .work-title {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .work-summary {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .work-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .work-highlights li {
    position: relative;
    padding-left: var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* A short accent rule per point, not a bullet glyph. */
  .work-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--accent-mark);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .work-item {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: center;
    }

    /* Alternate which side the screenshot sits on so consecutive rows do not
       read as a single repeated block. */
    .work-item[data-index='1'] .work-media,
    .work-item[data-index='3'] .work-media {
      order: 2;
    }
  }
</style>
