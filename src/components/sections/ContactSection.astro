---
import ContactForm from '@/components/ui/ContactForm';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import { socialLinks } from '@/data';

// Email first: it is the most direct way to reach me
const contactLinks = [...socialLinks].sort((a, b) => Number(b.icon === 'mail') - Number(a.icon === 'mail'));
---

<section id="contact" aria-labelledby="contact-title" class="relative py-14 md:py-18">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading id="contact-title" eyebrow="Contact" title="Let us build something excellent.">
      Have a project in mind or want to collaborate? Drop a message and I will respond quickly.
    </SectionHeading>

    <div class="mx-auto grid max-w-6xl items-start gap-8 lg:grid-cols-5">
      <div class="glass-card reveal rounded-3xl p-8 lg:col-span-2">
        <h3 class="mb-4 font-display text-xl font-semibold">Let us connect</h3>
        <p class="mb-6 text-white/70">
          I am open to freelance work, full-time roles, and partnerships that push the craft forward.
        </p>

        <ul class="space-y-4">
          {
            contactLinks.map((link) => {
              const external = link.icon !== 'mail';
              return (
                <li>
                  <a
                    href={link.href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/8"
                  >
                    <span class="flex size-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/80">
                      <SocialIcon name={link.icon} />
                    </span>
                    <span>
                      <span class="block text-xs tracking-caps text-white/50 uppercase">{link.name}</span>
                      <span class="block font-medium text-white/90 transition-colors group-hover:text-white">
                        {link.handle}
                      </span>
                    </span>
                    {external && <span class="sr-only">(opens in a new tab)</span>}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="glass-card reveal rounded-3xl p-8 md:p-10 lg:col-span-3" style="--delay: 100ms">
        <h3 class="mb-6 font-display text-2xl font-semibold">Send a message</h3>
        <ContactForm client:visible />
      </div>
    </div>
  </div>
</section>
