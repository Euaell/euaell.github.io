---
import { siteLinks } from "@/data/profile";
import ContactForm from "@/components/ui/ContactForm";
---

<section id="contact" class="section contact">
  <div class="container">
    <div class="contact-top">
      <h2>Let’s talk<span aria-hidden="true">.</span></h2><p>
        Have a role, a project, or an interesting problem?<br />I’d like to hear
        about it.
      </p>
    </div>
    <div class="contact-bottom">
      <a class="contact-email" href={"mailto:" + siteLinks.email}
        >{siteLinks.email}<svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        ></a
      >
      <div class="contact-social">
        <a
          class="text-link"
          href={siteLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          >GitHub <svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        ><a
          class="text-link"
          href={siteLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          >LinkedIn <svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
      </div>
    </div>
    <details class="contact-form">
      <summary
        >Prefer to leave a message here? <span aria-hidden="true"
          ><svg
            class="ui-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg
          ></span
        ></summary
      ><div class="contact-form-body">
        <p class="lede">Send a message.</p><ContactForm client:visible />
      </div>
    </details>
  </div>
</section>
<style>
  .contact {
    padding-bottom: 3rem;
  }
  .contact-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }
  .contact-top h2 {
    font-size: clamp(3.75rem, 8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .contact-top h2 span {
    color: var(--accent-mark);
  }
  .contact-top > p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }
  .contact-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
  }
  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    font-size: clamp(1.1rem, 2.8vw, 2.2rem);
    line-height: 1.4;
    letter-spacing: -0.025em;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
  }
  .contact-email:hover {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .contact-email svg {
    width: 27px;
    height: 27px;
    flex: none;
  }
  .contact-social {
    display: flex;
    gap: 1.6rem;
  }
  .contact-form {
    margin-top: 3.5rem;
    border-top: 1px solid var(--border);
  }
  .contact-form > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .contact-form > summary::-webkit-details-marker {
    display: none;
  }
  .contact-form > summary span {
    font-size: 1.25rem;
    transition: transform var(--dur) var(--ease);
  }
  .contact-form[open] > summary span {
    transform: rotate(45deg);
  }
  .contact-form-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 1.5rem 0;
  }
  .contact-form-body > .lede {
    font-size: 2rem;
    color: var(--text);
  }
  @media (max-width: 700px) {
    .contact-top,
    .contact-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }
    .contact-top h2 {
      font-size: 4rem;
    }
    .contact-bottom {
      margin-top: 1.6rem;
      gap: 1rem;
    }
    .contact-email {
      font-size: clamp(1.1rem, 5vw, 1.6rem);
      gap: 0.65rem;
    }
    .contact-email svg {
      width: 21px;
      height: 21px;
    }
    .contact-form-body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
