---
import { siteLinks, profileInfo } from '@/data/profile';

const channels = [
  {
    label: 'Email',
    value: siteLinks.email,
    href: `mailto:${siteLinks.email}`,
    external: false,
  },
  {
    label: 'GitHub',
    value: 'github.com/Euaell',
    href: siteLinks.github,
    external: true,
  },
  {
    label: 'LinkedIn',
    value: 'in/euael-eshete',
    href: siteLinks.linkedin,
    external: true,
  },
  {
    label: 'Resume',
    value: 'euaell.me/cv',
    href: siteLinks.resume,
    external: true,
  },
];
---

<section id="contact" class="section contact">
  <div class="container">
    <div class="contact-grid">
      <header class="contact-intro">
        <p class="eyebrow">Contact</p>
        <h2 class="heading">Get in touch</h2>
        <p class="lede">
          The fastest route is email. I read everything and reply to anything
          substantive, whether it is a role, a collaboration, or a question about
          something I have built.
        </p>
        <p class="meta contact-location">{profileInfo.location}</p>
      </header>

      <dl class="channels">
        {
          channels.map((channel) => (
            <div class="channel">
              <dt class="channel-label">{channel.label}</dt>
              <dd class="channel-value">
                <a
                  class="channel-link"
                  href={channel.href}
                  {...(channel.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {channel.value}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .contact-intro {
    max-width: 40rem;
  }

  .contact-intro .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
  }

  .contact-intro .heading {
    margin-bottom: var(--space-3);
  }

  .contact-location {
    margin-top: var(--space-4);
  }

  /* Contact routes as a definition list separated by rules, not icon cards. */
  .channels {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: var(--border-width) solid var(--border);
  }

  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--border);
  }

  .channel-label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .channel-value {
    margin: 0;
  }

  .channel-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    transition: color var(--dur) var(--ease);
  }

  .channel-link:hover {
    color: var(--accent-text);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
