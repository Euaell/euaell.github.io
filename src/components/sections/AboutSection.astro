---
import { Image } from 'astro:assets';
import { experienceData } from '@/data/experience';
import { educationData } from '@/data/education';
import { skillCategories } from '@/data/skills';
import { mentoringData, profileInfo } from '@/data/profile';
---

<section id="about" class="relative py-16 md:py-20 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 md:gap-12 items-start">
      <div class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class="glass-card rounded-3xl p-8 md:p-10 reveal">
          <div class="flex flex-col sm:flex-row gap-6 items-start">
            <div class="h-32 w-32 rounded-2xl overflow-hidden border border-white/10 bg-white/5">
              <Image
                src={profileInfo.image}
                alt={profileInfo.name}
                width={256}
                height={256}
                sizes="128px"
                class="h-full w-full object-cover scale-110 object-[40%_0%]"
                loading="lazy"
              />
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-2">Profile</p>
              <h3 class="text-2xl font-semibold font-display">{profileInfo.name}</h3>
              <p class="text-white/70 leading-relaxed mt-3">
                {profileInfo.bio}
              </p>
              <div class="mt-4 flex flex-wrap gap-2 text-xs uppercase tracking-[0.2em] text-white/60">
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-2">{profileInfo.location}</span>
              </div>
            </div>
          </div>

          <div class="mt-8">
            <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-4">Skills snapshot</p>
            <div class="grid md:grid-cols-2 gap-6">
              {skillCategories.map((category) => (
                <div class="space-y-3">
                  <div class="flex items-center gap-3">
                    <span class="h-1.5 w-1.5 rounded-full bg-primary-400"></span>
                    <h4 class="text-sm uppercase tracking-[0.2em] text-white/70">{category.title}</h4>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {category.skills.map((skill) => (
                      <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-white/70 transition hover:border-primary-400/40 hover:text-white">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-8">
        <div class="glass-card rounded-3xl p-8 md:p-10 reveal">
          <h3 class="text-xl font-semibold font-display mb-6">Experience</h3>
          <div class="divide-y divide-white/10">
            {experienceData.map((exp, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === experienceData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold">{exp.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-primary-300 font-medium">{exp.date}</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{exp.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{exp.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {exp.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="glass-card rounded-3xl p-8 md:p-10 reveal">
          <h3 class="text-xl font-semibold font-display mb-6">Education</h3>
          <div class="divide-y divide-white/10">
            {educationData.map((edu, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === educationData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold">{edu.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-accent-300 font-medium">{edu.date}</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{edu.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{edu.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {edu.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="glass-card rounded-3xl p-8 md:p-10 reveal">
          <h3 class="text-xl font-semibold font-display mb-6">Teaching & mentoring</h3>
          <div class="divide-y divide-white/10">
            {mentoringData.map((mentoring, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === mentoringData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold">{mentoring.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-primary-300 font-medium">{mentoring.date}</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{mentoring.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{mentoring.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {mentoring.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll('#about .reveal').forEach((el) => {
    revealObserver.observe(el);
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>
