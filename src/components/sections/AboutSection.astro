---
import { experienceData } from '@/data/experience';
import { educationData } from '@/data/education';
import { skillCategories } from '@/data/skills';
import { mentoringData, profileInfo } from '@/data/profile';
---

<section id="about" class="section about">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">About</p>
      <h2 class="heading">How I got here</h2>
      <p class="lede">{profileInfo.bio}</p>
    </header>

    <div class="about-grid">
      <div class="about-main">
        <section class="block" aria-labelledby="experience-heading">
          <h3 id="experience-heading" class="block-heading">Experience</h3>
          <ol class="timeline">
            {
              experienceData.map((job) => (
                <li class="entry">
                  <div class="entry-head">
                    <h4 class="entry-title">{job.title}</h4>
                    <p class="entry-when">{job.date}</p>
                  </div>
                  <p class="entry-org">
                    {job.subtitle}
                    <span class="sep" aria-hidden="true">·</span>
                    {job.location}
                  </p>
                  <ul class="entry-points">
                    {job.description.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="block" aria-labelledby="education-heading">
          <h3 id="education-heading" class="block-heading">Education</h3>
          <ol class="timeline">
            {
              educationData.map((study) => (
                <li class="entry">
                  <div class="entry-head">
                    <h4 class="entry-title">{study.title}</h4>
                    <p class="entry-when">{study.date}</p>
                  </div>
                  <p class="entry-org">
                    {study.subtitle}
                    <span class="sep" aria-hidden="true">·</span>
                    {study.location}
                  </p>
                  <ul class="entry-points">
                    {study.description.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="block" aria-labelledby="mentoring-heading">
          <h3 id="mentoring-heading" class="block-heading">Teaching and mentoring</h3>
          <ol class="timeline">
            {
              mentoringData.map((item) => (
                <li class="entry">
                  <div class="entry-head">
                    <h4 class="entry-title">{item.title}</h4>
                    <p class="entry-when">{item.date}</p>
                  </div>
                  <p class="entry-org">
                    {item.subtitle}
                    <span class="sep" aria-hidden="true">·</span>
                    {item.location}
                  </p>
                  <ul class="entry-points">
                    {item.description.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="about-aside" aria-labelledby="toolkit-heading">
        <h3 id="toolkit-heading" class="block-heading">Toolkit</h3>
        <dl class="toolkit">
          {
            skillCategories.map((category) => (
              <div class="toolkit-group">
                <dt class="toolkit-label">{category.title}</dt>
                <dd class="toolkit-items">{category.skills.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .section-head .eyebrow {
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-head .heading {
    margin-bottom: var(--space-3);
  }

  .about-grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .about-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .block-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-width) solid var(--border);
    margin-bottom: var(--space-5);
  }

  /* Entries are separated by rules rather than enclosed in cards, so long
     timelines stay calm and the eye follows a single column. */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .entry {
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--border);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .entry-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .entry-when {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .entry-org {
    margin-top: var(--space-1);
    font-size: 0.875rem;
    color: var(--accent-text);
  }

  .entry-points {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 62ch;
  }

  .entry-points li {
    position: relative;
    padding-left: var(--space-4);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .entry-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--accent-mark);
  }

  .toolkit {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
  }

  .toolkit-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-1);
  }

  .toolkit-items {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: var(--space-8);
    }

    .about-aside {
      position: sticky;
      top: calc(68px + var(--space-6));
    }
  }
</style>
