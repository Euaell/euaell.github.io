---
import { Image } from 'astro:assets';
import {
  experienceData,
  educationData,
  skillCategories,
  mentoringData,
  profileInfo,
} from '@/data';
---

<section id="about" class="relative py-16 md:py-20 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 md:gap-14 items-start">
      <!-- Sticky Profile & Skills Column -->
      <div class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class="glass-card rounded-3xl p-6 sm:p-8 reveal overflow-hidden">
          <!-- Horizontally Expanded Profile Photo -->
          <div class="w-full aspect-[16/10] sm:aspect-[16/9] rounded-2xl overflow-hidden border border-white/10 bg-white/5 mb-6">
            <Image
              src={profileInfo.image}
              alt={profileInfo.name}
              width={960}
              height={540}
              class="h-full w-full object-cover object-[center_18%]"
              loading="lazy"
            />
          </div>

          <div>
            <div class="flex items-center justify-between gap-3 mb-2">
              <p class="text-xs uppercase tracking-[0.3em] text-white/50">Profile</p>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs uppercase tracking-[0.15em] text-white/60">
                {profileInfo.location}
              </span>
            </div>
            <h3 class="text-2xl font-semibold font-display text-white">{profileInfo.name}</h3>
            <p class="text-white/70 leading-relaxed mt-3 text-sm sm:text-base">
              {profileInfo.bio}
            </p>
          </div>

          <!-- Skills Section (Renamed & Rearranged) -->
          <div class="mt-8 pt-8 border-t border-white/10">
            <p class="text-xs uppercase tracking-[0.3em] text-white/50 mb-5">Skills</p>
            <div class="space-y-4">
              {skillCategories.map((category) => (
                <div class="grid grid-cols-1 sm:grid-cols-[130px_1fr] gap-2 items-baseline">
                  <h4 class="text-xs uppercase tracking-[0.16em] font-medium text-white/60">
                    {category.title}
                  </h4>
                  <div class="flex flex-wrap gap-1.5">
                    {category.skills.map((skill) => (
                      <span class="rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-xs text-white/75 transition hover:border-white/25 hover:text-white hover:bg-white/[0.06]">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Experience, Education, Mentoring Column (No individual containing cards, separated by horizontal dividers) -->
      <div class="space-y-12">
        <!-- Experience -->
        <div class="reveal">
          <h3 class="text-xl font-semibold font-display mb-6 text-white">Experience</h3>
          <div class="divide-y divide-white/10">
            {experienceData.map((exp, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === experienceData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold text-white/95">{exp.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-blue-slate-300 font-medium">
                    {exp.date}
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{exp.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{exp.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {exp.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Education -->
        <div class="border-t border-white/10 pt-10 reveal">
          <h3 class="text-xl font-semibold font-display mb-6 text-white">Education</h3>
          <div class="divide-y divide-white/10">
            {educationData.map((edu, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === educationData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold text-white/95">{edu.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-blue-slate-300 font-medium">
                    {edu.date}
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{edu.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{edu.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {edu.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Teaching & Mentoring -->
        <div class="border-t border-white/10 pt-10 reveal">
          <h3 class="text-xl font-semibold font-display mb-6 text-white">Teaching & mentoring</h3>
          <div class="divide-y divide-white/10">
            {mentoringData.map((mentoring, idx) => (
              <div class={`${idx === 0 ? 'pb-6' : idx === mentoringData.length - 1 ? 'pt-6' : 'py-6'}`}>
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1.5">
                  <h4 class="text-lg font-semibold text-white/95">{mentoring.title}</h4>
                  <span class="text-xs uppercase tracking-[0.2em] text-blue-slate-300 font-medium">
                    {mentoring.date}
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-x-2 text-sm mb-3">
                  <span class="text-white/80 font-medium">{mentoring.subtitle}</span>
                  <span class="text-white/30">·</span>
                  <span class="text-white/50 text-xs">{mentoring.location}</span>
                </div>
                <ul class="space-y-2 text-sm text-white/70">
                  {mentoring.description.map((desc) => (
                    <li class="flex gap-2.5 items-start">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-white/40"></span>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('#about .reveal').forEach((el) => {
    revealObserver.observe(el);
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>
