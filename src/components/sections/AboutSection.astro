---
import { Image } from 'astro:assets';
import TimelineList from '@/components/ui/TimelineList.astro';
import { educationData, experienceData, mentoringData, profileInfo, skillCategories } from '@/data';
---

<section id="about" aria-labelledby="about-title" class="relative border-t border-white/5 py-16 md:py-20">
  <h2 id="about-title" class="sr-only">About</h2>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 md:gap-14 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <div class="glass-card reveal overflow-hidden rounded-3xl p-6 sm:p-8">
          <div class="flex flex-col items-start gap-6 sm:flex-row">
            <div class="size-32 shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <Image
                src={profileInfo.image}
                alt={`Portrait of ${profileInfo.name}`}
                width={256}
                height={256}
                sizes="128px"
                class="size-full object-cover object-[center_18%]"
                loading="lazy"
              />
            </div>

            <div>
              <p class="mb-2 text-xs tracking-eyebrow text-white/50 uppercase">Profile</p>
              <h3 class="font-display text-2xl font-semibold text-white">{profileInfo.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/70">{profileInfo.bio}</p>
              <p class="mt-4 inline-block rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs tracking-caps text-white/60 uppercase">
                {profileInfo.location}
              </p>
            </div>
          </div>

          <div class="mt-8 border-t border-white/10 pt-8">
            <h3 class="mb-5 text-xs tracking-eyebrow text-white/50 uppercase">Skills</h3>
            <dl class="space-y-4">
              {
                skillCategories.map((category) => (
                  <div class="grid grid-cols-1 items-baseline gap-2 sm:grid-cols-[8rem_1fr]">
                    <dt class="text-xs font-medium tracking-label text-white/60 uppercase">{category.title}</dt>
                    <dd class="flex flex-wrap gap-1.5">
                      {category.skills.map((skill) => (
                        <span class="rounded-md border border-white/10 bg-white/3 px-2.5 py-1 text-xs text-white/75 transition hover:border-white/25 hover:bg-white/6 hover:text-white">
                          {skill}
                        </span>
                      ))}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <div class="space-y-12">
        <TimelineList title="Experience" items={experienceData} />
        <TimelineList title="Education" items={educationData} class="border-t border-white/10 pt-10" />
        <TimelineList title="Teaching & mentoring" items={mentoringData} class="border-t border-white/10 pt-10" />
      </div>
    </div>
  </div>
</section>
