---
import { Image } from "astro:assets";
import portrait from "@/assets/portrait-casual.jpg";
import { experienceData } from "@/data/experience";
import { educationData } from "@/data/education";
import { skillCategories } from "@/data/skills";
import { mentoringData, siteLinks } from "@/data/profile";
---

<section id="about" class="section about">
  <div class="container">
    <div class="about-intro">
      <figure class="portrait">
        <Image
          src={portrait}
          alt="Euael smiling outdoors"
          width={640}
          height={800}
          widths={[360, 640, 900]}
          sizes="(min-width: 800px) 40vw, 100vw"
          loading="lazy"
        /><figcaption>
          <span>Euael M. Eshete</span><span>Addis Ababa, Ethiopia</span>
        </figcaption>
      </figure>
      <div class="about-copy">
        <h2 class="heading">The person<br />behind the work.</h2>
        <p class="about-lede">
          I’m a software engineer and the founder of <a
            class="link"
            href={siteLinks.studio}
            target="_blank"
            rel="noopener noreferrer">ZafTech</a
          >. I build products from the ground up and work on the systems that
          keep them running.
        </p>
        <p>
          At Securetron, I work on certificate lifecycle management: licensing,
          tenant isolation, certificate providers, and the authentication around
          them. At ZafTech, I design, build, and host products on a self-managed
          stack. I care about how that product holds up in production.
        </p>
        <p>
          I also teach and mentor. At A2SV, I mentored more than 150 students in
          full-stack development, AI integration, and cloud technologies.
        </p>
        <a
          class="text-link"
          href={siteLinks.resume}
          target="_blank"
          rel="noopener noreferrer"
          >Read my resume <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></a
        >
      </div>
    </div>
    <div class="background-grid">
      <div>
        <h3 class="column-heading">Along the way</h3>
        <div class="experience-list">
          {
            experienceData.map((job) => (
              <details class="experience">
                <>
                  <summary>
                    <>
                      <span>
                        <>
                          <strong>{job.subtitle}</strong>
                          <span class="job-title">{job.title}</span>
                        </>
                      </span>
                      <span class="job-date">{job.date}</span>
                      <span class="detail-plus" aria-hidden="true">
                        <svg
                          class="ui-icon"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          aria-hidden="true"
                        >
                          <path d="M12 5v14M5 12h14" />
                        </svg>
                      </span>
                    </>
                  </summary>
                  <div class="entry-detail">
                    <>
                      <p class="meta">{job.location}</p>
                      <ul>
                        {job.description.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    </>
                  </div>
                </>
              </details>
            ))
          }
        </div>
        <details class="experience education">
          <summary
            ><strong>Education & mentoring</strong><span
              class="detail-plus"
              aria-hidden="true"
              ><svg
                class="ui-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg
              ></span
            ></summary
          ><div class="entry-detail">
            {
              [...educationData, ...mentoringData].map((item) => (
                <div class="education-entry">
                  <>
                    <h4>
                      {item.title} · {item.subtitle}
                    </h4>
                    <p class="meta">{item.date}</p>
                    <ul>
                      {item.description.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  </>
                </div>
              ))
            }
          </div>
        </details>
      </div>
      <div class="toolkit">
        <h3 class="column-heading">Tools I reach for</h3><dl>
          {
            skillCategories.map((category) => (
              <div class="toolkit-row">
                <>
                  <dt>{category.title}</dt>
                  <dd>{category.skills.join(", ")}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
<style>
  .about {
    background: var(--bg-subtle);
  }
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .portrait {
    margin: 0;
  }
  .portrait img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: 56% 40%;
    border-radius: var(--radius-lg);
  }
  .portrait figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.6875rem;
  }
  .about-copy {
    max-width: 52ch;
  }
  .about-copy .heading {
    margin-bottom: 2rem;
  }
  .about-copy p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 1.25rem;
  }
  .about-copy .about-lede {
    font-size: clamp(1.125rem, 1.8vw, 1.4rem);
    line-height: 1.6;
    color: var(--text);
  }
  .about-copy .text-link {
    margin-top: 1.8rem;
  }
  .background-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: 5rem;
  }
  .column-heading {
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: 1.4rem;
  }
  .experience {
    border-bottom: 1px solid var(--border);
  }
  .experience summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 0;
    list-style: none;
    cursor: pointer;
  }
  .experience summary::-webkit-details-marker {
    display: none;
  }
  .experience strong {
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .job-title {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .job-date {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  .detail-plus {
    color: var(--text-muted);
    margin-left: auto;
    font-size: 1.2rem;
    transition: transform var(--dur) var(--ease);
  }
  .job-date + .detail-plus {
    margin-left: 0;
  }
  .experience[open] .detail-plus {
    transform: rotate(45deg);
  }
  .entry-detail {
    padding-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .entry-detail ul {
    list-style: disc;
    padding-left: 1.1rem;
    margin-top: 0.8rem;
  }
  .entry-detail li + li {
    margin-top: 0.6rem;
  }
  .education-entry + .education-entry {
    margin-top: 1.5rem;
  }
  .education-entry h4 {
    font-size: 0.9375rem;
    margin-bottom: 0.4rem;
    line-height: 1.4;
  }
  .toolkit-row {
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .toolkit-row dt {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .toolkit-row dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.65;
  }
  @media (max-width: 800px) {
    .about-intro {
      gap: 2rem;
    }
    .background-grid {
      gap: 2rem;
    }
    .job-date {
      white-space: normal;
      text-align: right;
      max-width: 9ch;
    }
    .toolkit-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
  @media (max-width: 600px) {
    .about-intro,
    .background-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 440px;
    }
    .portrait img {
      aspect-ratio: 1/1;
    }
    .about-copy {
      margin-top: 0.8rem;
    }
    .about-copy .heading {
      margin-bottom: 1.3rem;
    }
    .background-grid {
      margin-top: 3.5rem;
      gap: 3rem;
    }
    .toolkit-row {
      grid-template-columns: 108px 1fr;
      gap: 1rem;
    }
    .job-date {
      max-width: none;
    }
  }
</style>
