---
interface Props {
  eyebrow: string;
  title: string;
  /** Use h1 for a page's main heading; sections default to h2 */
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, as: Heading = 'h2', id } = Astro.props;
---

<header class="mx-auto mb-12 max-w-3xl text-center md:mb-16">
  <p class="mb-3 text-xs tracking-kicker text-white/50 uppercase">{eyebrow}</p>
  <Heading id={id} class="mb-4 font-display text-3xl font-semibold md:text-4xl lg:text-5xl">{title}</Heading>
  {
    Astro.slots.has('default') && (
      <p class="mx-auto max-w-2xl text-base text-white/70 md:text-lg">
        <slot />
      </p>
    )
  }
</header>
