---
// Floating Resume Button Component
---

<a
  href="https://euaell.me/cv"
  target="_blank"
  rel="noopener noreferrer"
  id="floating-resume-btn"
  class="fixed bottom-6 right-6 z-50 h-12 w-12 hover:w-32 rounded-full flex items-center justify-center transition-all duration-300 border border-white/15 bg-neutral-900/90 text-white backdrop-blur-md hover:border-white/35 hover:bg-neutral-800 group shadow-lg shadow-black/50 overflow-hidden"
  aria-label="View Resume"
>
  <div class="flex items-center justify-center gap-0 group-hover:gap-2.5 transition-all duration-300">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
      />
    </svg>
    <span class="resume-text hidden md:inline-block text-xs uppercase tracking-[0.16em] font-medium whitespace-nowrap">
      Resume
    </span>
  </div>
</a>

<style>
  .resume-text {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
  }

  #floating-resume-btn:hover .resume-text {
    max-width: 80px;
    opacity: 1;
  }
</style>
