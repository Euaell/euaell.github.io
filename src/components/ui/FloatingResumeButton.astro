---
// Floating Resume Button Component
---

<div class="group fixed right-6 bottom-6 z-50 flex items-center justify-center">
  <!-- Glassy wave: two soft rings ripple out every 2s while the button is idle -->
  <span
    class="beacon-wave pointer-events-none absolute size-12 rounded-full border border-white/20 bg-white/5 shadow-[inset_0_0_10px_rgb(255_255_255/0.12)] backdrop-blur-[1px] group-focus-within:invisible group-hover:invisible"
    aria-hidden="true"
  ></span>
  <span
    class="beacon-wave beacon-wave-trail pointer-events-none absolute size-12 rounded-full border border-white/10 group-focus-within:invisible group-hover:invisible"
    aria-hidden="true"
  ></span>

  <a
    href="https://euaell.me/cv"
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex h-12 w-12 items-center justify-center gap-0 overflow-hidden rounded-full border border-white/20 bg-neutral-900/95 text-white shadow-lg shadow-black/60 backdrop-blur-md transition-all duration-300 hover:border-white/40 hover:bg-neutral-800 md:hover:w-32 md:hover:gap-2.5 md:focus-visible:w-32 md:focus-visible:gap-2.5"
    aria-label="View Resume"
  >
    <svg class="size-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
      />
    </svg>
    <span
      class="hidden max-w-0 overflow-hidden text-xs font-medium tracking-[0.16em] whitespace-nowrap uppercase opacity-0 transition-all duration-300 group-focus-within:max-w-20 group-focus-within:opacity-100 group-hover:max-w-20 group-hover:opacity-100 md:inline-block"
    >
      Resume
    </span>
  </a>
</div>

<style>
  .beacon-wave {
    animation: beacon-wave 2s cubic-bezier(0.25, 0.8, 0.4, 1) infinite;
  }

  .beacon-wave-trail {
    animation-delay: 0.35s;
  }

  @keyframes beacon-wave {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }
</style>
