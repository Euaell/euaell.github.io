---
import type { TimelineItem } from '@/data';

interface Props {
  title: string;
  items: TimelineItem[];
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<section class:list={['reveal', className]} aria-label={title}>
  <h3 class="mb-6 font-display text-xl font-semibold text-white">{title}</h3>
  <ol class="divide-y divide-white/10">
    {
      items.map((item) => (
        <li class="py-6 first:pt-0 last:pb-0">
          <div class="mb-1.5 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h4 class="text-lg font-semibold text-white/95">{item.title}</h4>
            <span class="text-xs font-medium tracking-caps text-blue-slate-300 uppercase">{item.date}</span>
          </div>
          <p class="mb-3 flex flex-wrap items-center gap-x-2 text-sm">
            <span class="font-medium text-white/80">{item.subtitle}</span>
            <span class="text-white/30" aria-hidden="true">·</span>
            <span class="text-xs text-white/50">{item.location}</span>
          </p>
          <ul class="space-y-2 text-sm text-white/70">
            {item.description.map((line) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-white/40" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
