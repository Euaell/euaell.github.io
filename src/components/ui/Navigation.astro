---
import { navItems } from '@/data';
import MobileMenu from './MobileMenu';
---

<nav
  id="main-nav"
  aria-label="Primary"
  class="glass-liquid-strong fixed top-6 left-1/2 z-50 hidden w-fit -translate-x-1/2 rounded-full px-6 py-3 shadow-lg shadow-black/30 md:flex"
>
  <ul class="flex items-center gap-8">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link group relative py-1 text-xs tracking-caps text-white/70 uppercase transition-colors hover:text-white data-active:text-white"
          >
            {item.name}
            <span
              class="absolute -bottom-1 left-0 h-0.5 w-0 bg-white transition-[width] duration-300 group-data-active:w-full"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<MobileMenu client:media="(max-width: 47.99rem)" items={navItems} />

<script>
  // Highlight the link for whichever section crosses the line just below the nav
  const ACTIVE_LINE = 120;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#main-nav .nav-link')];
  const sections = links.map((link) => document.querySelector<HTMLElement>(link.hash));

  let frame = 0;

  function updateActiveLink() {
    frame = 0;
    sections.forEach((section, i) => {
      const rect = section?.getBoundingClientRect();
      const isActive = !!rect && rect.top <= ACTIVE_LINE && rect.bottom >= ACTIVE_LINE;
      links[i].toggleAttribute('data-active', isActive);
      if (isActive) links[i].setAttribute('aria-current', 'location');
      else links[i].removeAttribute('aria-current');
    });
  }

  window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(updateActiveLink)), { passive: true });
  updateActiveLink();
</script>
